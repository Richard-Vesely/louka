{
  "name": "louka",
  "private": true,
  "description": "Louka – multiplayerová survival hra v prohlížeči (AI kroužek)",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "playtest": "node tests/playtest/playtest.mjs client/dist",
    "start": "npm start -w server",
    "bots": "node tests/load/bots.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "playwright": "1.55.0"
  }
}
